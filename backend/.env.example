# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Base64 of the Firebase service account JSON:
#   base64 -i /path/to/serviceAccountKey.json | tr -d '\n'
# Base64 is used (rather than raw JSON) so the PEM private key's newlines
# survive .properties parsing untouched.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Alternative to the above — absolute path to the JSON file on disk.
# Used only when FIREBASE_SERVICE_ACCOUNT_BASE64 is empty.
#GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Optional — defaults shown.
#PORT=8081
#SVEMS_TIMEZONE=Asia/Kolkata
# Only needed if the UI is served from a different origin than this server.
#SVEMS_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Passwords for the two bootstrap accounts; used only when the users collection is empty.
#SVEMS_ADMIN_PASSWORD=Admin@123
#SVEMS_OPERATOR_PASSWORD=Operator@123
